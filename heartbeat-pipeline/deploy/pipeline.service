[Unit]
Description=Heartbeat Pipeline
After=network.target

[Service]
ExecStart=/usr/bin/node @APP_ROOT@/device/src/cli.js run
WorkingDirectory=@APP_ROOT@
Restart=always
RestartSec=1
User=pi
Group=pi
EnvironmentFile=/etc/heartbeat-pipeline/pipeline.env
CPUQuota=400%
MemoryMax=2G

[Install]
WantedBy=multi-user.target
